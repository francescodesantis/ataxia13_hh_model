model hh_macica:
    state:
        V_m mV = V_m_init
        V_m_old mV = V_m_init
        refr_t ms = 0 ms  
        n real = alpha_n_init / (alpha_n_init + beta_n_init)
        m real = alpha_m_init / (alpha_m_init + beta_m_init)
        h real = alpha_h_init / (alpha_h_init + beta_h_init)

    equations:
        # =====================================================
        # Ionic currents
        # =====================================================
        inline I_Na pA = g_Na * m * m * m * h * (V_m - E_Na)
        inline I_Kv3_1 pA = g_Kv3_1 * n * n * n * (E_Kv3_1 - V_m)
        inline I_L pA = g_L * (V_m - E_L)

        # =====================================================
        # Potassium channel V 3.1 kinetics (Stabilized)
        # =====================================================
        # Denominator caps exponential growth at high voltages
        inline alpha_n real = (k_alpha_n * exp(eta_alpha_n * (V_m / mV ))) / (1.0 + exp(0.1 * (V_m / mV - 20.0)))
        inline beta_n real = k_beta_n * exp(eta_beta_n * (V_m / mV ))
        n' = (alpha_n * (1.0 - n) - beta_n * n) / ms

        # =====================================================
        # Sodium activation (m) (Stabilized)
        # =====================================================
        inline alpha_m real = (k_alpha_m * exp(eta_alpha_m * (V_m / mV ))) / (1.0 + exp(0.1 * (V_m / mV - 40.0)))
        inline beta_m real = k_beta_m * exp(eta_beta_m * (V_m / mV ))
        m' = (alpha_m * (1.0 - m) - beta_m * m) / ms

        # =====================================================
        # Sodium inactivation (h) (Stabilized)
        # =====================================================
        inline alpha_h real = k_alpha_h * exp(eta_alpha_h * (V_m / mV ))
        inline beta_h real = (k_beta_h * exp(eta_beta_h * (V_m / mV ))) / (1.0 + exp(0.1 * (V_m / mV - 40.0)))
        h' = (alpha_h * (1.0 - h) - beta_h * h) / ms

        # =====================================================
        # Membrane equation
        # =====================================================
        V_m' = (-(I_Na + I_Kv3_1 + I_L) + I_e + I_stim) / C_m
        refr_t' = -1.0

    parameters:
        # =====================================================
        # Membrane parameters (Defaults from params.py)
        # =====================================================
        V_m_init mV = -63.0 mV    # Matched to E_L to prevent initial jump
        C_m pF = 22.36 pF         #
        g_Na nS = 500.0 nS        #
        g_Kv3_1 nS = 150.0 nS     #
        g_L nS = 2.0 nS           #
        E_Na mV = 50.0 mV         #
        E_Kv3_1 mV = -80.0 mV     #
        E_L mV = -63.0 mV         #
        I_e pA = 0.0 pA           #
        refr_T ms = 1.0 ms        #

        # =====================================================
        # Potassium V 3.1 kinetics parameters
        # =====================================================
        k_alpha_n real = 0.2719   #
        eta_alpha_n real = 0.04   #
        k_beta_n real = 0.1974    #
        eta_beta_n real = 0.0     #

        # =====================================================
        # Sodium kinetics parameters
        # =====================================================
        k_alpha_m real = 76.4     #
        eta_alpha_m real = 0.037  #
        k_beta_m real = 6.93      #
        eta_beta_m real = -0.043  #

        k_alpha_h real = 0.000533 #
        eta_alpha_h real = -0.0909 #
        k_beta_h real = 7.87      #
        eta_beta_h real = 0.0691  #

    internals:
        # Initial gate values calculated at V_m_init
        alpha_n_init real = (k_alpha_n * exp(eta_alpha_n * (V_m_init / mV ))) / (1.0 + exp(0.1 * (V_m_init / mV - 20.0)))
        beta_n_init real = k_beta_n * exp(eta_beta_n * (V_m_init / mV ))
        alpha_m_init real = (k_alpha_m * exp(eta_alpha_m * (V_m_init / mV ))) / (1.0 + exp(0.1 * (V_m_init / mV - 40.0)))
        beta_m_init real = k_beta_m * exp(eta_beta_m * (V_m_init / mV ))
        alpha_h_init real = k_alpha_h * exp(eta_alpha_h * (V_m_init / mV ))
        beta_h_init real = (k_beta_h * exp(eta_beta_h * (V_m_init / mV ))) / (1.0 + exp(0.1 * (V_m_init / mV - 40.0)))

    input:
        I_stim pA <- continuous

    output:
        spike

    update:
        V_m_old = V_m
        if refr_t > 0 ms:
            integrate_odes(V_m, n, m, h, refr_t)
        else:
            integrate_odes(V_m, n, m, h)

    onCondition(refr_t <= 0 ms and V_m > 0 mV and V_m_old > V_m):
        refr_t = refr_T
        emit_spike()